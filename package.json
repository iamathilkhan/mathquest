{
  "name": "mathquiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:build": "tsx scripts/build-seedbank.ts",
    "seed:verified": "node --conditions=react-server --import tsx scripts/generate-verified-seeds.ts",
    "seed:lessons": "node --conditions=react-server --import tsx scripts/generate-seed-lessons.ts",
    "art:gen": "tsx scripts/gen-images.ts",
    "art:process": "tsx scripts/art-process.ts",
    "eval": "node --conditions=react-server --import tsx scripts/eval-generation.ts",
    "diagnose:art": "node --conditions=react-server --import tsx scripts/diagnose-art.ts",
    "balance": "node --import tsx scripts/balance-sim.ts",
    "release-check": "node --conditions=react-server --import tsx scripts/release-check.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.6.0",
    "mathjs": "^15.2.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
